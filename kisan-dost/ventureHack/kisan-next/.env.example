# ==============================================================================
# KisanDost / AgriShield 360° Environment Configuration Template
# NOTE: DO NOT commit actual secrets or sensitive credentials to version control.
# Copy this template to .env.local and populate with your environment-specific values.
# ==============================================================================

# Core Database (Required for all phases)
# MongoDB connection URI (e.g., local MongoDB or MongoDB Atlas)
MONGODB_URI=

# Authentication & Security
# Secret key used for signing and verifying JSON Web Tokens (JWT)
JWT_SECRET=

# Environment Designation (development, test, production)
NEXT_PUBLIC_ENV=

# Phase 0 & Phase 5: Weather Service Configuration
# WeatherAPI.com API key for current and forecast weather
WEATHER_API_KEY=
# Open-Meteo API base URL (optional, defaults to https://archive-api.open-meteo.com/v1/archive)
OPEN_METEO_BASE_URL=

# Phase 4: AgriVision Image Diagnosis Service
# AgriVision external disease detection microservice endpoint (e.g., http://localhost:8000/api/v1/diagnose)
AGRI_VISION_API_URL=

# Assistant & Notification Integrations
# Google Gemini API key for advisory reasoning and generative features
GEMINI_API_KEY=
# Fast2SMS API key for farmer SMS notifications
FAST2SMS_API_KEY=

# Python AI Microservice (Optional)
# URL for the Python AI FastAPI backend service
PYTHON_AI_SERVICE_URL=
# Flag to enable/disable delegating requests to Python AI backend ('true' or 'false')
USE_PYTHON_BACKEND=

# Phase 4 Image Storage Provider Configuration
# Storage mode: 'local' (default for dev), 'cloudinary', or 'r2'
IMAGE_STORAGE_PROVIDER=

# Cloudinary Credentials (Required only if IMAGE_STORAGE_PROVIDER='cloudinary')
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2 Credentials (Required only if IMAGE_STORAGE_PROVIDER='r2')
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=
